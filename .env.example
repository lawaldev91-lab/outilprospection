# Configuration des notifications email
# Copiez ce fichier en .env et remplissez vos informations

# Activer les notifications email
EMAIL_NOTIFICATIONS=false

# Configuration SMTP (exemple Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application

# Email du destinataire
NOTIFICATION_EMAIL=votre-email@gmail.com

# Note pour Gmail :
# 1. Activez la vérification en 2 étapes sur votre compte Google
# 2. Générez un "mot de passe d'application" sur https://myaccount.google.com/apppasswords
# 3. Utilisez ce mot de passe dans SMTP_PASSWORD (pas votre mot de passe Gmail)

# Configuration Reddit (optionnel)
REDDIT_CLIENT_ID=VOTRE_CLIENT_ID
REDDIT_CLIENT_SECRET=VOTRE_CLIENT_SECRET
REDDIT_ENABLED=false
